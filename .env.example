# Copy this file to .env. Do not commit .env to GitHub.
# Use the Project endpoint shown on the Microsoft Foundry project home page.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# Exact Foundry agent name; for the supplied lab pattern this may be it-support-agent.
FOUNDRY_AGENT_NAME=your-agent-name
# true = local UI preview only; false = attempt a real Foundry request.
DEMO_MODE=true
